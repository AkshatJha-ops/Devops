pipeline {
    agent any

    stages {
        stage('Checkout Files') {
            steps {
                dir('Exercise-9-Jenkins-Multistage') {
                    bat 'xcopy /E /I /Y "C:\\Users\\Akshat\\Documents\\Devops\\Exercise-9-Jenkins-Multistage\\*" .'
                }
            }
        }

        stage('Build') {
            steps {
                dir('Exercise-9-Jenkins-Multistage') {
                    bat 'py -3.11 --version'
                    bat 'if exist .venv-ci rmdir /s /q .venv-ci'
                    bat 'py -3.11 -m venv .venv-ci'
                    bat '.venv-ci\\Scripts\\python -m pip install --upgrade pip'
                    bat '.venv-ci\\Scripts\\python -m pip install Flask==3.1.1 Werkzeug==3.1.3'
                }
            }
        }

        stage('Test') {
            steps {
                dir('Exercise-9-Jenkins-Multistage') {
                    bat '.venv-ci\\Scripts\\python -m unittest discover -s . -p "test_*.py" -v'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('Exercise-9-Jenkins-Multistage') {
                    bat 'if not exist python-app-deploy mkdir python-app-deploy'
                    bat 'copy /Y app.py python-app-deploy\\app.py'
                    bat 'copy /Y requirements.txt python-app-deploy\\requirements.txt'
                }
            }
        }
    }

    post {
        success {
            echo 'Exercise 9 pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the stage logs.'
        }
    }
}
